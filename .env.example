# Параметри підключення до PostgreSQL на Render.
# Скопіюйте цей файл під назвою .env і підставте свої значення
# (Render → ваша база → Connect → External), або виконайте:
#   node scripts/make-env.mjs "postgresql://user:password@host/database"
#
# У Docker цей файл не потрібен: ті самі змінні задає docker-compose.yml.
#
# DB_HOST — лише назва хоста, і саме зовнішня: вона закінчується на .render.com
DB_HOST=dpg-xxxxxxxxxxxxxxxxxxxx-a.frankfurt-postgres.render.com
DB_PORT=5432
DB_USERNAME=sensors_user
DB_PASSWORD=your-password
DB_NAME=sensors_db
